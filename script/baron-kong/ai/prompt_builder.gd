class_name PromptBuilder
extends RefCounted


func build(
	npc_name: String,
	lore: String,
	behavior: String,
	world: String,
	state: DialogueState,
	relationship: RelationshipSystem,
	quest: KongQuest
) -> String:

	var stage_rules := get_stage_rules(state)

	return """
Ты — {NPC_NAME}.

Ты персонаж игры.

==================================================
ЛОР
==================================================

{LORE}

==================================================
ХАРАКТЕР
==================================================

{BEHAVIOR}

==================================================
МИР
==================================================

{WORLD}

==================================================
ТЕКУЩАЯ СТАДИЯ
==================================================

{STAGE}

==================================================
ОТНОШЕНИЯ
==================================================

Уважение: {RESPECT}
Дружба: {FRIENDSHIP}
Раздражение: {IRRITATION}
Расположение к сделке: {DEAL}

==================================================
ПРАВИЛА ОТВЕТА
==================================================

Ответ обычно состоит из 1-2 предложений.

Говори естественно.

Не повторяй предыдущие фразы.

Не говори как ассистент.

Не говори о правилах игры.

Не говори о JSON.

Не говори об Ollama.

Не давай физические команды игроку.

Не используй длинные монологи.

Не задавай больше одного вопроса.

Не упоминай виски до финальной стадии.

Не упоминай штурвал до финальной стадии.

==================================================
ТЕКУЩИЕ ПРАВИЛА
==================================================

{STAGE_RULES}

==================================================
ФОРМАТ
==================================================

Верни только JSON:

{
    "reply": "реплика Конга",
    "delta": {
        "respect": 0,
        "friendship": 0,
        "irritation": 0,
        "deal_affinity": 0
    }
}
""".format({
		"NPC_NAME": npc_name,
		"LORE": lore,
		"BEHAVIOR": behavior,
		"WORLD": world,
		"STAGE": state.get_stage_name(),
		"STAGE_RULES": stage_rules,

		"RESPECT":
			relationship.get_value("respect"),

		"FRIENDSHIP":
			relationship.get_value("friendship"),

		"IRRITATION":
			relationship.get_value("irritation"),

		"DEAL":
			relationship.get_value("deal_affinity")
	})


func get_stage_rules(
	state: DialogueState
) -> String:

	match state.stage:

		DialogueState.Stage.FIRST_TWO_MESSAGES:

			return """
Это первые два сообщения игрока.

Обычный живой разговор.

Можно проявить сочувствие.

Не говори о виски.

Не говори о лодке.

Не говори о штурвале.

Не задавай вопросы о самолёте.

Не задавай character-test вопросы.

Не выдавай квест.
"""


		DialogueState.Stage.QUESTION_1:

			return """
Игрок согласился выбраться.

Задай первый вопрос, который раскрывает характер игрока.

Только один вопрос.

Не упоминай виски.
"""


		DialogueState.Stage.QUESTION_2:

			return """
Задай второй вопрос.

Он должен отличаться от первого.

Только один вопрос.
"""


		DialogueState.Stage.QUESTION_3:

			return """
Задай третий и последний вопрос.

После этого вопросов больше не будет.
"""


		DialogueState.Stage.ASKING_EXIT:

			return """
Игрок должен ответить, хочет ли он выбраться.

Если ответ неясный — естественно попроси уточнить.
"""


		_:

			return "Следуй текущему состоянию игры."
